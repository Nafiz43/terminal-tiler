#!/bin/bash
# terminal-tiler — keep Apple Terminal windows tiled equally across the screen.
#
# Usage:
#   terminal-tiler              # run in foreground (watches for new/closed windows)
#   terminal-tiler once         # tile current windows and exit
#   terminal-tiler install      # install LaunchAgent (starts at login)
#   terminal-tiler uninstall    # remove LaunchAgent
#   terminal-tiler start|stop|status
#
# Requires: System Settings → Privacy & Security → Accessibility → allow Terminal
#           (or allow `osascript` / this script's parent if run from launchd)

set -euo pipefail

LABEL="com.user.terminal-tiler"
PLIST="$HOME/Library/LaunchAgents/${LABEL}.plist"
SCRIPT="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
POLL_SECONDS="${TERMINAL_TILER_POLL:-0.6}"
LOG_FILE="${TERMINAL_TILER_LOG:-$HOME/Library/Logs/terminal-tiler.log}"

tile_once() {
  /usr/bin/osascript <<'APPLESCRIPT'
-- Tile all visible Terminal windows equally across the main display's usable area.
-- Layout: 1=full, 2=halves, 3=thirds (columns), 4+=grid (≈sqrt columns).

use framework "AppKit"
use scripting additions

on visibleFrame()
	set mainScreen to current application's NSScreen's mainScreen()
	set fullFrame to mainScreen's frame()
	set vf to mainScreen's visibleFrame()
	-- Cocoa origin is bottom-left; AppleScript window bounds use top-left.
	set screenHeight to current application's NSHeight(fullFrame)
	set x to current application's NSMinX(vf)
	set yCocoa to current application's NSMinY(vf)
	set w to current application's NSWidth(vf)
	set h to current application's NSHeight(vf)
	set topY to screenHeight - yCocoa - h
	return {x, topY, w, h}
end visibleFrame

on gridFor(n)
	if n ≤ 0 then return {0, 0}
	if n = 1 then return {1, 1}
	if n = 2 then return {2, 1}
	if n = 3 then return {3, 1}
	-- 4+ → near-square grid (prefer more columns than rows for wide screens)
	set cols to (n ^ 0.5) as integer
	if cols * cols < n then set cols to cols + 1
	set rows to (n / cols) as integer
	if rows * cols < n then set rows to rows + 1
	return {cols, rows}
end gridFor

on tileTerminals()
	tell application "Terminal"
		if not running then return "0"
		set wins to every window
		set n to count of wins
		if n = 0 then return "0"

		set {ox, oy, ow, oh} to my visibleFrame()
		set {cols, rows} to my gridFor(n)
		set cellW to ow / cols
		set cellH to oh / rows

		-- Front-to-back order is unstable; sort by window id for stable placement.
		set idList to {}
		repeat with w in wins
			set end of idList to id of w
		end repeat

		-- Simple insertion sort (AppleScript has no built-in sort for lists of numbers)
		set sortedIds to idList
		set m to count of sortedIds
		repeat with i from 2 to m
			set keyVal to item i of sortedIds
			set j to i - 1
			repeat while j ≥ 1 and (item j of sortedIds) > keyVal
				set item (j + 1) of sortedIds to item j of sortedIds
				set j to j - 1
			end repeat
			set item (j + 1) of sortedIds to keyVal
		end repeat

		set idx to 0
		repeat with wid in sortedIds
			set col to idx mod cols
			set row to idx div cols
			set x1 to ox + (col * cellW)
			set y1 to oy + (row * cellH)
			set x2 to x1 + cellW
			set y2 to y1 + cellH
			-- Integer pixel bounds avoid gaps/overlap from float rounding
			set x1i to x1 as integer
			set y1i to y1 as integer
			set x2i to x2 as integer
			set y2i to y2 as integer
			try
				set bounds of window id wid to {x1i, y1i, x2i, y2i}
			end try
			set idx to idx + 1
		end repeat
		return (n as text)
	end tell
end tileTerminals

tileTerminals()
APPLESCRIPT
}

count_windows() {
  /usr/bin/osascript <<'EOF' 2>/dev/null || echo 0
if application "Terminal" is running then
  tell application "Terminal" to count windows
else
  0
end if
EOF
}

watch_loop() {
  echo "[$(date '+%F %T')] terminal-tiler watching (poll=${POLL_SECONDS}s)" >>"$LOG_FILE"
  local last=-1
  while true; do
    local n
    n="$(count_windows)"
    n="${n//[^0-9]/}"
    n="${n:-0}"
    if [[ "$n" != "$last" ]]; then
      # Brief settle so the new window finishes opening / animating
      sleep 0.25
      local tiled
      tiled="$(tile_once 2>>"$LOG_FILE" || true)"
      echo "[$(date '+%F %T')] windows=${n} tiled=${tiled:-?}" >>"$LOG_FILE"
      last="$n"
    fi
    sleep "$POLL_SECONDS"
  done
}

install_agent() {
  cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>${SCRIPT}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>${LOG_FILE}</string>
  <key>StandardErrorPath</key>
  <string>${LOG_FILE}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
EOF
  launchctl bootout "gui/$(id -u)/${LABEL}" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$PLIST"
  launchctl enable "gui/$(id -u)/${LABEL}" 2>/dev/null || true
  echo "Installed and started: $PLIST"
  echo "Log: $LOG_FILE"
  echo
  echo "Grant Accessibility access if tiling does nothing:"
  echo "  System Settings → Privacy & Security → Accessibility"
  echo "  Enable: /usr/bin/osascript  (and/or Terminal, and this script if prompted)"
}

uninstall_agent() {
  launchctl bootout "gui/$(id -u)/${LABEL}" 2>/dev/null || true
  rm -f "$PLIST"
  echo "Uninstalled ${LABEL}"
}

cmd_status() {
  if launchctl print "gui/$(id -u)/${LABEL}" >/dev/null 2>&1; then
    echo "LaunchAgent: running"
  else
    echo "LaunchAgent: not loaded"
  fi
  echo "Windows now: $(count_windows)"
  echo "Log: $LOG_FILE"
}

case "${1:-}" in
  once) tile_once; echo ;;
  install) install_agent ;;
  uninstall) uninstall_agent ;;
  start) install_agent ;;
  stop)
    launchctl bootout "gui/$(id -u)/${LABEL}" 2>/dev/null || true
    echo "Stopped (plist kept at $PLIST — run uninstall to remove)"
    ;;
  status) cmd_status ;;
  ""|watch) watch_loop ;;
  -h|--help|help)
    sed -n '2,14p' "$SCRIPT"
    ;;
  *)
    echo "Unknown command: $1" >&2
    echo "Try: terminal-tiler help" >&2
    exit 1
    ;;
esac
